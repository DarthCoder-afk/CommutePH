DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Server-only key used for Metro Manila place autocomplete.
# Never prefix this variable with NEXT_PUBLIC_.
# MAPTILER_API_KEY=replace-with-a-maptiler-key

# Optional locally because development has a raster fallback.
# Required in production. Replace this example with your provider's style URL.
# NEXT_PUBLIC_MAP_STYLE_URL=https://maps.example.com/style.json
