{
  "packageManager": "pnpm@11.6.0",
  "name": "commutemap-ph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "tsx scripts/prepare-standalone.ts",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "tsx scripts/check-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check-location": "tsx scripts/check-location-roundtrip.ts",
    "db:check-location-constraints": "tsx scripts/check-location-constraints.ts",
    "db:check-location-readiness": "tsx scripts/check-location-readiness.ts",
    "db:import-provisional-stops": "tsx scripts/import-provisional-stops.ts",
    "db:fetch-osm-provisional-stops": "tsx scripts/fetch-osm-provisional-stops.ts",
    "db:fetch-osm-provisional-routes": "tsx scripts/fetch-osm-provisional-routes.ts",
    "db:report-provisional-locations": "tsx scripts/report-provisional-locations.ts",
    "db:import-provisional-routes": "tsx scripts/import-provisional-routes.ts",
    "db:promote-route-candidate": "tsx scripts/promote-route-candidate.ts",
    "db:sync-location-duplicate-reviews": "tsx scripts/sync-location-duplicate-reviews.ts",
    "db:report-location-duplicate-reviews": "tsx scripts/report-location-duplicate-reviews.ts",
    "db:review-location-duplicate": "tsx scripts/review-location-duplicate.ts",
    "db:record-location-field-observation": "tsx scripts/record-location-field-observation.ts",
    "db:report-location-field-observations": "tsx scripts/report-location-field-observations.ts",
    "db:review-location-field-observation": "tsx scripts/review-location-field-observation.ts",
    "db:report-location-verification-decisions": "tsx scripts/report-location-verification-decisions.ts",
    "db:record-route-field-observation": "tsx scripts/record-route-field-observation.ts",
    "db:report-route-field-observations": "tsx scripts/report-route-field-observations.ts",
    "db:review-route-field-observation": "tsx scripts/review-route-field-observation.ts",
    "db:report-route-verification-decisions": "tsx scripts/report-route-verification-decisions.ts",
    "db:record-journey-field-observation": "tsx scripts/record-journey-field-observation.ts",
    "db:report-journey-field-observations": "tsx scripts/report-journey-field-observations.ts",
    "db:review-journey-field-observation": "tsx scripts/review-journey-field-observation.ts",
    "db:report-journey-verification-decisions": "tsx scripts/report-journey-verification-decisions.ts",
    "db:seed": "tsx scripts/seed-locations.ts",
    "db:seed-draft-routes": "tsx scripts/seed-draft-routes.ts",
    "db:seed-draft-journey": "tsx scripts/seed-draft-journey.ts",
    "db:check-draft-journey": "tsx scripts/check-draft-journey.ts",
    "db:check-journey-readiness": "tsx scripts/check-journey-readiness.ts",
    "db:report-journey-release-readiness": "tsx scripts/report-journey-release-readiness.ts",
    "db:prepare-journey-fieldwork": "tsx scripts/prepare-journey-fieldwork.ts",
    "db:replace-draft-journey-fixture-location": "tsx scripts/replace-draft-journey-fixture-location.ts",
    "db:report-journey-fixture-replacements": "tsx scripts/report-journey-fixture-replacements.ts",
    "test:journey-estimates": "tsx --test src/server/journeys/calculate-journey-estimates.test.ts",
    "test:env": "tsx --test src/config/database-url.test.ts",
    "test:journey-segments": "tsx --test src/server/journeys/assemble-journey-segments.test.ts",
    "test:journey-map": "tsx --test src/server/journeys/build-journey-map-geojson.test.ts",
    "test:route-schedules": "tsx --test src/server/routes/assemble-published-route-schedules.test.ts",
    "test:journey-paths": "tsx --test src/server/journeys/assemble-published-journey-paths.test.ts",
    "test:http-responses": "tsx --test src/server/http/json-no-store.test.ts",
    "test:verification-freshness": "tsx --test src/server/verification/verification-freshness.test.ts",
    "test:map-style-url": "tsx --test src/config/map-style-url.test.ts",
    "test": "tsx --test src/config/*.test.ts src/lib/*/*.test.ts src/server/*/*.test.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:public-release": "tsx scripts/check-public-release.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.28.0",
    "maplibre-gl": "^6.1.0",
    "next": "16.2.12",
    "pg": "8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5"
  }
}
