{
  "packageManager": "pnpm@11.6.0",
  "name": "commutemap-ph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "tsx scripts/check-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check-location": "tsx scripts/check-location-roundtrip.ts",
    "db:check-location-constraints": "tsx scripts/check-location-constraints.ts",
    "db:seed": "tsx scripts/seed-locations.ts",
    "db:seed-draft-routes": "tsx scripts/seed-draft-routes.ts",
    "db:seed-draft-journey": "tsx scripts/seed-draft-journey.ts",
    "db:check-draft-journey": "tsx scripts/check-draft-journey.ts",
    "db:check-journey-readiness": "tsx scripts/check-journey-readiness.ts",
    "test:journey-estimates": "tsx --test src/server/journeys/calculate-journey-estimates.test.ts",
    "test:env": "tsx --test src/config/database-url.test.ts",
    "test:journey-segments": "tsx --test src/server/journeys/assemble-journey-segments.test.ts",
    "test:journey-map": "tsx --test src/server/journeys/build-journey-map-geojson.test.ts",
    "test:route-schedules": "tsx --test src/server/routes/assemble-published-route-schedules.test.ts",
    "test:journey-paths": "tsx --test src/server/journeys/assemble-published-journey-paths.test.ts",
    "test:http-responses": "tsx --test src/server/http/json-no-store.test.ts",
    "check:public-release": "tsx scripts/check-public-release.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "maplibre-gl": "^6.1.0",
    "next": "16.2.12",
    "pg": "8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5"
  }
}
